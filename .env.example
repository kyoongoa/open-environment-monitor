# Django
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database. Use DB_ENGINE=sqlite for a no-MySQL local demo.
DB_ENGINE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=environment_monitoring
DB_USER=YOUR_DATABASE_USER
DB_PASSWORD=YOUR_DATABASE_PASSWORD

# Real-time provider (currently: openweather). Create your own key at
# https://openweathermap.org/api. Never commit the actual value.
ENVIRONMENT_PROVIDER=openweather
OPENWEATHER_API_KEY=YOUR_API_KEY
ENVIRONMENT_CACHE_SECONDS=300
